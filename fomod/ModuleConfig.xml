<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">

  <moduleName>Logitech G-series Wheel Mod</moduleName>

  <!-- No top-level moduleDependencies. Vortex already enforces game
       association before the FOMOD runs, and `state="Active"` checks
       mod-tracked files, not base-game files. Real prerequisites
       (RED4ext, ArchiveXL, Mod Settings, Logitech G HUB) are documented
       on the Nexus mod page using Nexus's native dependency / required-
       mods declarations rather than nagged through the FOMOD installer
       (FOMOD steps are for install-time customization, not info dumps). -->

  <!-- The only customization the user makes during install is the
       startup handshake on/off. Everything else is fixed payload. -->

  <requiredInstallFiles>
    <file source="build\gwheel.dll"
          destination="red4ext\plugins\gwheel\gwheel.dll"/>

    <!-- Patched mod_settings: DLL + redscript bundle + Wolvenkit-packed
         archive (.inkwidget layout edits) + ArchiveXL .xl manifest.
         Vortex will flag all four as conflicts against upstream Mod
         Settings. The "File conflicts" install step below pre-warns
         the user to let this mod win all of them. -->
    <file source="mod_settings\mod_settings.dll"
          destination="red4ext\plugins\mod_settings\mod_settings.dll"/>
    <file source="mod_settings\packed.reds"
          destination="red4ext\plugins\mod_settings\packed.reds"/>
    <file source="mod_settings\ModSettings.archive"
          destination="red4ext\plugins\mod_settings\ModSettings.archive"/>
    <file source="mod_settings\ModSettings.archive.xl"
          destination="red4ext\plugins\mod_settings\ModSettings.archive.xl"/>

    <file source="gwheel_reds\gwheel_natives.reds"
          destination="r6\scripts\gwheel\gwheel_natives.reds"/>
    <file source="gwheel_reds\gwheel_settings.reds"
          destination="r6\scripts\gwheel\gwheel_settings.reds"/>
    <file source="gwheel_reds\gwheel_mount.reds"
          destination="r6\scripts\gwheel\gwheel_mount.reds"/>
    <file source="gwheel_reds\gwheel_events.reds"
          destination="r6\scripts\gwheel\gwheel_events.reds"/>
    <file source="gwheel_reds\gwheel_surface.reds"
          destination="r6\scripts\gwheel\gwheel_surface.reds"/>
    <file source="gwheel_reds\gwheel_vehicle_signals.reds"
          destination="r6\scripts\gwheel\gwheel_vehicle_signals.reds"/>
    <file source="gwheel_reds\gwheel_input_provider.reds"
          destination="r6\scripts\gwheel\gwheel_input_provider.reds"/>
  </requiredInstallFiles>

  <installSteps order="Explicit">

    <!-- Pre-warn the user about the Mod Settings file-conflict prompt.
         Vortex shows the prompt at deploy time (after this installer
         finishes), so we can't silence it here, but we can explain it
         in advance. The plugin is type="Required" with no files, so
         it acts as a read-only info page. -->
    <installStep name="File conflicts (read this)">
      <optionalFileGroups order="Explicit">
        <group name="About the Mod Settings file conflicts" type="SelectAll">
          <plugins order="Explicit">

            <plugin name="Choose THIS mod to win all Mod Settings conflicts">
              <description>This mod ships a small fork of Mod Settings (the same one already installed via Mod Settings on Nexus) with one extra UI primitive that lets you bind wheel buttons. The fork is API-compatible with upstream Mod Settings, so other mods that use Mod Settings keep working.

After you click Install, Vortex will show a "File conflicts" prompt for FOUR files belonging to Mod Settings:

  - mod_settings.dll
  - packed.reds
  - ModSettings.archive
  - ModSettings.archive.xl

For each one, choose "Logitech G-series Wheel Mod" to win the conflict (load AFTER Mod Settings). Don't pick Mod Settings, or the new bind-your-wheel UI won't appear in the in-game Settings page.

If you ever uninstall this mod, reinstall Mod Settings from its Nexus page to restore the upstream files.</description>
              <typeDescriptor>
                <type name="Required"/>
              </typeDescriptor>
            </plugin>

          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>

    <installStep name="Startup handshake">
      <optionalFileGroups order="Explicit">

        <group name="Pon pon shi handshake" type="SelectExactlyOne">
          <plugins order="Explicit">

            <plugin name="Pon pon shi greeting (on)">
              <description>On game start, briefly pulse the wheel's LEDs and force-feedback motors and run a centering spring to return the wheel to 0 degrees. Toggle anytime in the in-game Mod Settings menu.</description>
              <files>
                <file source="fomod_configs\config_handshake_on.json"
                      destination="red4ext\plugins\gwheel\config.json"/>
              </files>
              <typeDescriptor>
                <type name="Recommended"/>
              </typeDescriptor>
            </plugin>

            <plugin name="Pon pon shi greeting (off)">
              <description>Skip the startup pulses. The wheel stays silent on game start. Toggle anytime in the in-game Mod Settings menu.</description>
              <files>
                <file source="fomod_configs\config_handshake_off.json"
                      destination="red4ext\plugins\gwheel\config.json"/>
              </files>
              <typeDescriptor>
                <type name="Optional"/>
              </typeDescriptor>
            </plugin>

          </plugins>
        </group>

      </optionalFileGroups>
    </installStep>

  </installSteps>

</config>
